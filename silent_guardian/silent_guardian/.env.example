# Copy to .env for local development (not needed on Render if you set
# these as dashboard environment variables instead).

SECRET_KEY=change-me
VIOLENCE_THRESHOLD=0.55
ALERT_COOLDOWN_SECONDS=15
FRAME_SAMPLE_RATE=5

# Optional email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=security-team@example.com
ALERT_EMAIL_FROM=youraddress@gmail.com

# Optional Slack/Discord-style webhook alert
ALERT_WEBHOOK_URL=
